<Project>
  <PropertyGroup>
    <!-- Eclipse Zenoh Rust crate version embedded in native binaries -->
    <ZenohVersion>1.9.0</ZenohVersion>
    <!-- NuGet package version: {ZenohVersion}.{dotnet-patch} -->
    <Version>1.9.0.0</Version>
    <!-- UPM package version: {ZenohVersion}-native.{dotnet-patch} (see scripts/upm-version.sh) -->
  </PropertyGroup>
</Project>
